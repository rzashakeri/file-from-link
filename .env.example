# --- Required ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
API_SECRET=change-me-to-a-long-random-string

# --- EC2 / public address (needed for >50MB file links and Serverless mode) ---
PUBLIC_BASE_URL=https://dl.example.com
# S3 (optional, recommended for >50MB delivery instead of local links)
# S3_BUCKET=
# AWS_REGION=eu-central-1

# --- Limits ---
MAX_FILESIZE_MB=2000
TELEGRAM_UPLOAD_LIMIT_MB=49
MAX_JOBS_PER_USER=3
JOB_TIMEOUT_SECONDS=1800
FILE_TTL_HOURS=24
WORKER_CONCURRENCY_HINT=2

# --- YouTube bot-wall: PO Token provider (bgutil sidecar, started by compose) ---
POT_BASE_URL=http://pot-provider:4416
# --- Optional: YouTube cookies (export from your browser, keep OUT of git) ---
# YTDLP_COOKIES_FILE=/data/cookies.txt

REDIS_URL=redis://redis:6379/0
DATABASE_PATH=/data/jobs.db
DOWNLOAD_DIR=/data/downloads
PUBLIC_DIR=/data/public
